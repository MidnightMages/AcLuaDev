local args={...}
args=args[1]
local oldComponent=component
_G.component=nil
local component={name="component"}
local raw={}
raw.raw={}
raw.disk={}
raw.bios={}
raw.computer={}
raw.screen={}
raw.speaker={}
raw.modem={}
local restricted=table.deepcopy(raw)

for i,v in oldComponent.list() do
    if table.contains(args.restrictedComponents, i) then
        restricted[i][#restricted[i]+1]={t=i,o=v}
        restricted.raw[#restricted.raw+1]={t=i,o=v}
    else
        raw[i][#raw[i]+1]={t=i,o=v}
        raw.raw[#raw.raw+1]={t=i,o=v}
        restricted[i][#restricted[i]+1]={t=i,o=v}
        restricted.raw[#restricted.raw+1]={t=i,o=v}
    end
end

function component.list(filter)
    local list=raw.raw
    if filter then
        list=raw[filter]
    end
    local maxi=#list
    local i=0
    return function()
        i=i+1
        if i<=maxi then
            return list[i].t, list[i].o
        end
    end
end

function component.forceGet(query, key)
    if key==args.key then
        if query==nil then
            return restricted
        end
        return restricted[query]
    end
end

function component.get(query)
    if query==nil then
        return raw
    end
    return raw[query]
end

return component