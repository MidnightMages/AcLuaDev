-- Get boot arguments
local bootArgs = {...}
bootArgs=bootArgs[1]

-- Define globals
_G.kernel={}

-- Define locals
local package={} -- GET THIS
package.loaded={}
local processes={} -- GET THIS
local nextUUID=-1
local callbackEvents={}
local currentPCB={PATH="boot/Hyprkrnl.sys"}
local currentTCB={}
local component = component -- GET THIS
local driverArgs={ -- GET THIS
    key={},
    restrictedComponents={"bios","disk"},
    bootDrive=bootArgs.bootDrive,
    component=component
}

-- My favorite function
local function PANIC(err) -- GET THIS
    error(err)
end

print("compiling make.sys")
local ok,err = pcall(load(bootArgs.bootDrive:open("boot/make.sys"):read()), driverArgs)
if not ok then
    PANIC("make failed to load/execute err:\n"..err)
end

-- Make expect
local function expect(idx, val, typ)
    if type(typ)=="string"then
        typ={typ}
    end
    local exit = false
    for i,v in ipairs(typ) do
        if val == v then
            exit=true
        end
    end
    if not exit then
        error("Invalid type for argument "..idx)
    end
end

-- Kernel library
function kernel.version()
    return "Hyprkrnl 1.0.0"
end

function kernel.generateUUID()
    nextUUID=nextUUID+1
    return nextUUID
end

function kernel.createCallbackEvent(event, func)
    expect(1,event,"string")
    expect(2,func,"function")
    if not callbackEvents[event] then
        callbackEvents[event]={}
    end
    nextUUID=nextUUID+1
    local id=nextUUID
    callbackEvents[event][tostring(id)]={
        UUID=id,
        func=func,
        process=currentPCB.UUID
    }
    return {
        removeCallbackEvent=function()
            callbackEvents[event][tostring(id)]=nil
        end
    }
end

function kernel.triggerCallbackEvent(event, ...)
    if callbackEvents[event] then
        for i,v in ipairs(callbackEvents[event]) do
            pcall(v.func, ...)
        end
    end
end

-- Make thread library
local thread={}
function thread.getTCB(func, name)
    nextUUID=nextUUID+1
    local id=nextUUID
    local threadID=tostring(id)
    if name then
        threadID=name
    end
    return {
        UUID=id,
        name=threadID,
        coro=coroutine.create(func)
    }
end

function thread.add(func, name)
    nextUUID=nextUUID+1
    local id=nextUUID
    local threadID=tostring(id)
    if name and not currentPCB[name] then
        threadID=name
    end
    currentPCB.threads[threadID]={
        UUID=id,
        name=threadID,
        coro=coroutine.create(func)
    }
    return {
        terminate=function()
            currentPCB.threads[threadID]=nil
        end
    }
end
package.loaded.thread=thread -- Publish thread

-- Make processes avalible
function kernel.createProcessFromFunc(func, name)
    nextUUID=nextUUID+1
    local id=nextUUID
    local PID=tostring(id)
    if name then
        PID=name
    end
    processes[tostring(id)]={
        UUID=id,
        name=PID,
        PATH=currentPCB.PATH,
        threads={
            main=thread.getTCB(func, "main")
        }
    }
end

function kernel.exit()
    if currentTCB.name=="main" then
        currentPCB=nil
    else
        currentPCB.threads[currentTCB.name]=nil
    end
    coroutine.yield()
end

-- Load drivers
local files = bootArgs.bootDrive:list("lib/modules")
for i,v in ipairs(files) do
    print("compiling "..v)
    local ok,err = pcall(load(bootArgs.bootDrive:open("lib/modules/"..v):read()), driverArgs)
    if not ok then
        PANIC("Driver "..v.." failed to load/execute err:\n"..err)
    end
    local name=v
    if err.name then
        name=err.name
        err.name=nil
    end
    package.loaded[name]=err
    print("Loaded "..v)
end
files = nil
local fs=package.loaded.filesystem

-- Other QOL functions
function loadfile(path, OENV)
    local env = table.deepcopy(_G)
    if OENV then
        env=OENV
    end
    local c = fs.open(path)
    local file = c.readAll()
    c.close()
    return assert(load(file, path, "t", env))
end

function kernel.createProcessFromFile(path, name)
    local tmp=currentPCB.PATH
    currentPCB.PATH=path
    local n=path
    if name then
        n=name
    end
    kernel.createProcessFromFunc(loadfile(path),n)
    currentPCB.PATH=tmp
end

function dofile(path, ...)
    return assert(loadfile(path)(...))
end

-- Make require
local function require(query)
    if package.loaded[query] then
        return package.loaded[query]
    end
    local tokens=string.split(query, ".")
    local path="/lib/"
    local id=""
    for i,v in ipairs(tokens) do
        path=path..v.."/"
        id=id..v.."."
    end
    path=string.sub(path,1,#path)
    local pack=dofile(path)
    package.loaded[id]=pack
    return pack
end
_G.require=require

-- Difine main kernel process
local function main()
    local function eventHandler()
        while true do
            print("eventHandler")
            local event={computer.getMachineEvent()}
            print(table.unpack(event))
            kernel.triggerCallbackEvent(table.unpack(event))
            coroutine.yield()
        end
    end
    thread.add(eventHandler,"eventHandler")
    while true do
        coroutine.yield()
    end
end

kernel.createProcessFromFunc(main, "Hyprkrnl") -- Add process
kernel.createProcessFromFile("sys/Hyperion.sys", "Hyperion") -- Get OS file

-- Main
while true do
    for i,v in pairs(processes) do
        currentPCB=v
        if currentPCB.UUID~=nil then
            for i2, v2 in pairs(currentPCB.threads) do
                currentTCB=v
                local ret={coroutine.resume(v2.coro)}
                if coroutine.status(v2.coro)=="dead" then
                    if i2=="main" then
                        currentPCB=nil
                    else
                        currentPCB.threads[i2]=nil
                    end
                end
            end
            processes[i]=currentPCB
        end
    end
    sleep(0.1)
end