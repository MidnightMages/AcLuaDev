local bootArgs = {...}
bootArgs=bootArgs[1]
_G.kernel={}
function table.deepcopy(tabl)
    local out = {}
    for i,v in pairs(tabl) do
        local t=type(v)
        if t=="table" then
            if i == "_G" then
                out._G=out
            else
                out[i]=table.deepcopy(v)
            end
        else
            out[i]=v
        end
    end
    return out
end

local function PANIC(err)
    error(err)
end

local processes={}
local nextPid=0
local callbackEvents={}
local currentPCB={}
local eventUUID=0

local function expect(idx, val, typ)
    if type(typ)=="string"then
        typ={typ}
    end
    local exit = false
    for i,v in ipairs(typ) do
        if val == v then
            exit=true
        end
    end
    if not exit then
        error("Invalid type for argument "..idx)
    end
end

function kernel.createCallbackEvent(event, func)
    expect(1,event,"string")
    expect(2,func,"function")
    if not callbackEvents[event] then
        callbackEvents[event]={}
    end
    callbackEvents[event][tostring(eventUUID)]={
        func=func,
        process=currentPCB.UUID
    }
    return {
        removeCallbackEvent=function()
            callbackEvents[event][tostring(eventUUID)]=nil
        end
    }
end

function kernel.triggerCallbackEvent(event, ...)
    if callbackEvents[event] then
        for i,v in ipairs(callbackEvents[event]) do
            pcall(v, ...)
        end
    end
end

function kernel.createProcess(func, Oname, Oenv)
    local name=tostring(nextPid)
    if Oname then
        name=Oname
    end
    expect(1, func, {"function", "thread"})
    if type(func)=="thread" then
        func=coroutine.create(func)
    end
    processes[tostring(nextPid)]={
        UUID=nextPid,
        name=name,
        coro=func,
        env=Oenv
    }
    nextPid=nextPid+1
end

_G.func=function(input,space)
    if not space then
        space=""
    end
    for i,v in pairs(input) do
        print(space,i,v)
        if type(v) == "table" and i ~= "_G" then
            func(v,space.."    ")
        end
    end
end
local driverArgs = {
    key={}
}
package={}
package.loaded={}
local function loadDrivers()
    local files = bootArgs.bootDrive:list("lib/modules")
    for i,v in ipairs(files) do
        local ok,err = pcall(load(bootArgs.bootDrive:open("lib/modules/"..v).read()), driverArgs)
        if not ok then
            PANIC("Driver "..v.." failed to load/execute")
        end
        local name=v
        if err.name then
            name=err.name
            err.name=nil
        end
        package.loaded[name]=err
        print("Loaded "..v)
    end
end
loadDrivers()
local fs=package.loaded.filesystem

function loadfile(path, OENV)
    local env = table.deepcopy(_G)
    if OENV then
        env=OENV
    end
    local c = fs.open(path)
    local file = c.readAll()
    c.close()
    return assert(load(file, path, "t", env))
end

function dofile(path, ...)
    return assert(loadfile(path)(...))
end

function kernel.createProcessFromFile(path)
    local env = table.deepcopy(_G)
    kernel.createProcess(loadfile(path, env), path, env)
end

func(_G)
