-- Get boot arguments
local bootArgs = {...}
bootArgs=bootArgs[1]

-- Define locals
_G.printInline=printInline
local kernel={}
local processes={} -- GET THIS
local nextUUID=-1
local callbackEvents={}
local currentPCB={PATH="boot/Hyprkrnl.sys"}
local currentTCB={}
local component = component -- GET THIS
local driverArgs={ -- GET THIS
    key={},
    restrictedComponents={"bios","disk"},
    bootDrive=bootArgs.bootDrive,
    component=component,
    kernelArgs=bootArgs
}
local eventProc=""
local oldSleep=sleep

-- My favorite function
local function PANIC(err) -- GET THIS
    error(err)
end

print("compiling make.sys")
local ok,err = pcall(load(bootArgs.bootDrive:open("boot/make.sys"):read()), driverArgs)
if not ok then
    PANIC("make failed to load/execute err:\n"..err)
end
local publish=require("require").publish

-- Kernel library
function kernel.version()
    return "Hyprkrnl 1.0.0"
end

function kernel.generateUUID()
    nextUUID=nextUUID+1
    return nextUUID
end

function kernel.generateKey()
    return {}
end

function kernel.createCallbackEvent(event,func)
    nextUUID=nextUUID+1
    local id=nextUUID
    if not table.hasKey(callbackEvents,event) then
        callbackEvents[event]={}
    end
    callbackEvents[event][tostring(id)]={
        UUID=id,
        func=func,
        process=currentPCB.UUID
    }
    return {
        removeCallbackEvent=function()
            callbackEvents[tostring(id)]=nil
        end
    }
end

-- Make thread library
local thread={}
function thread.getTCB(func, name, ...)
    nextUUID=nextUUID+1
    local id=nextUUID
    local threadID=tostring(id)
    if name then
        threadID=name
    end
    local args={...}
    if #args==0 then
        args=nil
    end
    return {
        UUID=id,
        name=threadID,
        status="initialize",
        launchArgs=args,
        coro=coroutine.create(function()
            func(table.unpack(args or {}))
        end)
    }
end

function kernel.triggerCallbackEvent(event,...)
    if not table.hasKey(callbackEvents,event) then return end
    for i,v in pairs(callbackEvents[event]) do
        processes[eventProc].threads[kernel.generateUUID()]=thread.getTCB(v.func,tostring(v.UUID),...)
    end
end

function thread.add(func, name, ...)
    nextUUID=nextUUID+1
    local id=nextUUID
    local threadID=tostring(id)
    if name and not currentPCB[name] then
        threadID=name
    end
    local args={...}
    if #args==0 then
        args=nil
    end
    currentPCB.threads[threadID]={
        UUID=id,
        name=threadID,
        status="initialize",
        launchArgs=args,
        coro=coroutine.create(function()
            func(table.unpack(args or {}))
        end)
    }
    return {
        terminate=function()
            currentPCB.threads[threadID]=nil
        end,
        isActive=function()
            if currentPCB.threads[threadID]~=nil then
                return true
            else
                return false
            end
        end
    }
end

function thread.exit()
    currentTCB.status="stopping"
    coroutine.yield()
end

publish("thread",thread)-- Publish thread

-- Make processes avalible
function kernel.createProcessFromFunc(func, name, ...)
    nextUUID=nextUUID+1
    local id=nextUUID
    local PID=tostring(id)
    if name then
        PID=name
    end
    processes[tostring(id)]={
        UUID=id,
        name=PID,
        PATH=currentPCB.PATH,
        threads={
            main=thread.getTCB(func, "main", ...)
        }
    }
    return {
        getUUID=function()
            return tostring(id)
        end
    }
end
publish("kernel",kernel)

-- Load drivers
local files = bootArgs.bootDrive:list("lib/modules")
for i,v in ipairs(files) do
    print("compiling "..v)
    local ok,err = pcall(load(bootArgs.bootDrive:open("lib/modules/"..v):read()), driverArgs)
    if not ok then
        PANIC("Driver "..v.." failed to load/execute err:\n"..err)
    end
    local name=v
    if err.name then
        name=err.name
        err.name=nil
    end
    publish(name,err)
    print("Loaded "..v)
end
files = nil
local fs=require("filesystem")

-- Other QOL functions
function loadfile(path, OENV)
    local env = table.deepcopy(_G)
    if OENV then
        env=OENV
    end
    local c = fs.open(path)
    local file = c.readAll()
    c.close()
    c=nil
    return assert(load(file, path, "t", env))
end

function kernel.createProcessFromFile(path, name, ...)
    local tmp=currentPCB.PATH
    currentPCB.PATH=path
    local n=path
    if name then
        n=name
    end
    kernel.createProcessFromFunc(loadfile(path),n, ...)
    currentPCB.PATH=tmp
end
publish("kernel",kernel,driverArgs.key)

function dofile(path, ...)
    return assert(loadfile(path)(...))
end

function _G.sleep(time)
    local i=0
    currentTCB.status="sleeping"
    while i<time do
        i=i+0.05
        coroutine.yield()
    end
    coroutine.yield()
    currentTCB.status="queued"
end
_G.func=function(input,space)
    if not space then
        space=""
    end
    for i,v in pairs(input) do
        print(space,i,v)
        if type(v) == "table" and i ~= "_G" then
            func(v,space.."    ")
        end
    end
end
-- Difine main kernel process
local function main()
    local function eventHandler()
        while true do
            kernel.triggerCallbackEvent(computer.getMachineEvent())
            coroutine.yield()
        end
    end
    thread.add(eventHandler,"eventHandler")
    
    while true do
        sleep(1)
    end
end

kernel.createProcessFromFunc(main, "Hyprkrnl") -- Add process
eventProc=kernel.createProcessFromFunc(function()
    while true do sleep(10) end
end,"eventProc").getUUID()
kernel.createProcessFromFile("sys/Hyperion.sys", "Hyperion") -- Get OS file

-- Main
while true do
    for i,v in pairs(processes) do
        currentPCB=v
        if currentPCB.UUID~=nil then
            for i2, v2 in pairs(currentPCB.threads) do
                currentTCB=v2
                currentTCB.status="running"
                local ret={coroutine.resume(v2.coro)}
                currentTCB.status="queued"
                currentPCB.threads[i2]=currentTCB
                if coroutine.status(v2.coro)=="dead" or currentTCB.status=="stopping" then
                    if i2=="main" then
                        currentPCB=nil
                    else
                        currentPCB.threads[i2]=nil
                    end
                end
            end
            processes[i]=currentPCB
        end
    end
    oldSleep(0.05)
end