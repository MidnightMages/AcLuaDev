local fs=require("filesystem")
local shell=require(("shell"))
local args={...}
local function printUsage()
    print("ls \"Path\"")
end
if args[1]==nil then
    for i,v in ipairs(fs.list(shell.getDir())) do
        print(v)
    end
else
    for i,v in ipairs(fs.list(args[1])) do
        print(v)
    end
end