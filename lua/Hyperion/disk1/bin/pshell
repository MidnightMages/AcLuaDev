local events=require("events")
local kernel=require("kernel")
local thread=require("thread")
local publish=require("require").publish
local fs=require("filesystem")
local stringBuffer=""
local cwd="/"
local captureInput=true
local command={}
local shell={}

local function printPrefix()
    printInline("root@testharness:"..cwd.."$ ")
end

local function tokenise(str)
    return string.split(str," ")
end

function shell.dir()
    return cwd
end

function shell.setDir(dir)
    cwd=dir
    return cwd
end
publish("shell",shell)

kernel.createCallbackEvent(events.key,function(...)
    if not captureInput then return end
    local key={...}
    key=key[1]
    if key=="\b" then
        if #stringBuffer>0 then
            printInline("\b")
            stringBuffer=string.sub(stringBuffer,1,#stringBuffer-1)
        end
    elseif key=="\n" then
        captureInput=false
        if stringBuffer=="" then captureInput=true end
        command=tokenise(stringBuffer)
        stringBuffer=""
        print()
    else
        printInline(key)
        stringBuffer=stringBuffer..key
    end
end)

printPrefix()
while true do
    if captureInput==false then
        if (not fs.exists("bin/"..command[1])) or fs.isDir("bin/"..command[1]) then captureInput=true; goto exit end
        local handle=thread.add(loadfile("bin/"..command[1]),command[1],table.unpack(command,2))
        command={}
        while handle.isActive() do
            coroutine.yield()
        end
        captureInput=true
        printPrefix()
    end
    ::exit::
    coroutine.yield()
end